# Hearth configuration. Copy to .env and adjust; Bun loads .env on its own.

# Absolute path to the Obsidian vault. Leave unset to find the vault named
# HEARTH_VAULT_NAME in Obsidian's own config (~/Library/Application Support/obsidian/obsidian.json).
# HEARTH_VAULT=/path/to/your/vault

# Vault name, used to find the vault and to build obsidian:// links.
HEARTH_VAULT_NAME=pandora

# Port the server listens on (always 127.0.0.1 only).
HEARTH_PORT=4747

# Seconds with no input before ⏱ Auto-lock locks the page (when it is on in that browser).
HEARTH_LOCK_AFTER=30

# Vault folders, relative to the vault root. The defaults match pandora's layout;
# change one only if you moved that folder (and its notes) in the vault.
HEARTH_KIN_DIR="kin"
HEARTH_CONVERSATIONS_DIR="conversations"
HEARTH_PRACTICE_DIR="practice"
HEARTH_PROJECTS_DIR="projects"
HEARTH_ROUGH_DIR="rough-notes"

# The 📊 Talk screen reads Beeper Desktop's local index. It hides itself when Beeper is not here; "off" hides it anyway.
# HEARTH_BEEPER="off"

# Leave unset to run on your Claude Code login (subscription usage).
# Setting it switches every turn to API billing on that key, real money per token.
# ANTHROPIC_API_KEY=
